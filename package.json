{
  "name": "xle-grammar-explorer",
  "version": "0.0.1",
  "description": "Visual two-pane explorer for XLE/LFG grammars: a working tree of grammar sections plus an editor.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:parser && npm run test:tokens && npm run test:xle && npm run harness",
    "test:parser": "tsc -p tsconfig.harness.json && node --test '.harness/src/**/*.node-spec.js'",
    "test:ng": "ng test --watch=false --browsers=ChromeHeadlessNoSandbox",
    "harness": "tsc -p tsconfig.harness.json && node .harness/tools/parse-all-grammars.js",
    "index": "tsc -p tsconfig.harness.json && node .harness/tools/index-grammar.js",
    "test:tokens": "tsc -p tsconfig.harness.json && node .harness/tools/tokenize-all-grammars.js && node tools/parse-with-codemirror.mjs",
    "test:all": "npm test && npm run test:ng",
    "xle": "node server/index.mjs",
    "test:xle": "node --test 'server/*.test.mjs'",
    "app": "npm run build && node server/launch.mjs",
    "app:quick": "node server/launch.mjs"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.1.3",
    "@angular/cli": "^16.1.3",
    "@angular/compiler-cli": "^16.1.3",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^26.5.0",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "typescript": "~5.1.3"
  },
  "dependencies": {
    "@angular/animations": "^16.1.3",
    "@angular/cdk": "^16.1.3",
    "@angular/common": "^16.1.3",
    "@angular/compiler": "^16.1.3",
    "@angular/core": "^16.1.3",
    "@angular/forms": "^16.1.3",
    "@angular/material": "^16.1.3",
    "@angular/platform-browser": "^16.1.3",
    "@angular/platform-browser-dynamic": "^16.1.3",
    "@angular/router": "^16.1.3",
    "@codemirror/commands": "^6.3.3",
    "@codemirror/language": "^6.10.1",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.26.3",
    "@lezer/highlight": "^1.2.0",
    "@types/cytoscape": "^3.21.9",
    "codemirror": "^6.0.1",
    "cytoscape": "^3.30.2",
    "cytoscape-dagre": "^2.5.0",
    "dagre": "^0.8.5",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.0",
    "zone.js": "^0.13.1"
  }
}
